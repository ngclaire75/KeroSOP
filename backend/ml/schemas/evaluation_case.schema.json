{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KEROSOP synthetic evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "doc_family", "dataset_split", "language_pair", "premise", "hypothesis", "context", "evidence_span_ids", "source_spans", "label", "license", "commercial_eligible", "annotation_status", "rights_note", "source_type"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "doc_family": {"type": "string", "minLength": 1},
    "dataset_split": {"enum": ["train", "validation", "test"]},
    "language_pair": {"type": "string", "minLength": 2},
    "premise": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "context": {"type": "string"},
    "evidence_span_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "source_spans": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["span_id", "quote", "document_version_id"], "additionalProperties": false, "properties": {"span_id": {"type": "string"}, "quote": {"type": "string", "minLength": 1}, "document_version_id": {"type": "string", "minLength": 1}}}},
    "label": {"enum": ["direct_conflict", "permission_prohibition_conflict", "deadline_mismatch", "threshold_mismatch", "role_conflict", "version_drift", "missing_documented_step", "ambiguous", "compatible", "valid_exception", "historical_difference", "insufficient_evidence"]},
    "license": {"type": "string"},
    "commercial_eligible": {"type": "boolean"},
    "annotation_status": {"type": "string"},
    "rights_note": {"type": "string"},
    "source_type": {"type": "string"}
  }
}
